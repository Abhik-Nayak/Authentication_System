{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],

    // CommonJS on purpose: Express, Prisma, ts-node and Jest all work with zero
    // ESM plumbing. apps/web (Next.js) brings its own tsconfig and does not use this.
    "module": "CommonJS",
    "moduleResolution": "node",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  }
}
